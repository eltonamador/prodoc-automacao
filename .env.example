# Copie para .env e preencha. O .env NÃO é commitado (veja .gitignore).
#   cp .env.example .env && chmod 600 .env

# Credenciais do Prodoc (as mesmas do login em https://prodoc.ap.gov.br)
PRODOC_USER=
PRODOC_PASSWORD=

# Chave da API do Claude (https://console.anthropic.com)
CLAUDE_API_KEY=

# Token do OpenClaw, se o endpoint exigir autenticação (deixe vazio se não exigir)
OPENCLAW_TOKEN=
